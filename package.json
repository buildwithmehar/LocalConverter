{
  "name": "local-converter",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "mammoth": {
      "argparse": "2.0.1"
    },
    "@huggingface/transformers": {
      "sharp": "$sharp"
    },
    "body-parser": "2.4.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "clean": "node scripts/clean.mjs",
    "qa:local": "node scripts/qa/seo-local.mjs",
    "qa:public": "node scripts/qa/seo-public.mjs",
    "report:operations": "node scripts/generate-operation-report.js",
    "dev": "node scripts/dev-browser.mjs",
    "dev:local": "node server/index.js --dev",
    "build": "npm run tool-assets && vite build && node scripts/export-browser-site.mjs",
    "icons": "node scripts/generate-brand-icons.mjs",
    "start": "node scripts/serve-browser-preview.mjs --production",
    "start:local": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:ui": "playwright test",
    "verify": "npm test && npm run build && npm run test:ui",
    "tool-assets": "node scripts/build-tool-assets.mjs",
    "test:roadmap": "playwright test --config playwright.roadmap.config.js",
    "test:browser": "node scripts/build-tool-assets.mjs && node scripts/verify-browser-build.mjs && node --test tests/browser-runtime.test.js tests/browser-utility.test.js tests/browser-image-document.test.js tests/browser-media.test.js tests/browser-advanced-document.test.js tests/browser-site-export.test.js tests/pandoc-loader.test.js && node scripts/audit-browser-seo.mjs .artifacts/browser-website && playwright test --config playwright.browser-site.config.js",
    "build:public": "npm run build",
    "seo:export": "node scripts/export-browser-site.mjs",
    "test:seo": "node --test tests/browser-site-export.test.js tests/public-analytics-discovery.test.js && node scripts/audit-browser-seo.mjs",
    "test:seo:legacy": "node --test tests/seo-discovery.test.js tests/seo-public.test.js tests/seo-final-pass.test.js tests/public-analytics-discovery.test.js && playwright test --config playwright.seo.config.js && playwright test --config playwright.public.config.js"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource-variable/inter": "5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@iarna/toml": "^2.2.5",
    "@jspawn/qpdf-wasm": "0.0.2",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/jxl": "1.3.0",
    "@jsquash/webp": "1.5.0",
    "@lipoe/browser-qpdf": "0.3.1",
    "@microsoft/fast-element": "3.1.2",
    "@napi-rs/canvas": "1.0.11",
    "@react-spring/web": "10.1.2",
    "@scure/bip39": "2.4.0",
    "@zxing/library": "^0.23.0",
    "ag-psd": "33.0.0",
    "ajv": "8.20.0",
    "bwip-js": "^4.11.4",
    "clean-css": "5.3.3",
    "clsx": "2.1.1",
    "cron-parser": "5.10.2",
    "cronstrue": "3.38.0",
    "csso": "5.0.5",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "exceljs": "4.4.0",
    "exifreader": "4.51.0",
    "express": "5.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "0.8.3",
    "fonteditor-core": "2.6.3",
    "gifenc": "1.0.3",
    "he": "^2.0.0",
    "heic-to": "1.6.6",
    "html-minifier-terser": "7.2.0",
    "html2canvas": "1.4.1",
    "iconv-lite": "^0.7.3",
    "jsdom": "30.1.3",
    "jsonpath-plus": "11.2.1",
    "libraw-wasm": "1.6.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "1.60.0",
    "mammoth": "1.13.0",
    "markdown-it": "15.0.3",
    "marked": "18.1.1",
    "mermaid": "12.2.0",
    "motion": "14.4.0",
    "multer": "2.5.0",
    "onnxruntime-web": "1.30.0",
    "pandoc-wasm": "1.1.0",
    "papaparse": "5.7.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "qr-code-styling": "1.9.2",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-flip-toolkit": "7.2.4",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "sql-formatter": "15.9.0",
    "svgo": "^4.1.0",
    "tailwind-merge": "3.7.0",
    "terser": "5.51.2",
    "tesseract.js": "^7.0.0",
    "ulid": "3.0.2",
    "utif2": "4.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  }
}
